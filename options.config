# Changes to Debian's config. Each line is checked in the final .config.

# 1000 Hz timer: lower timer and input latency.
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# Full preemption by default; preempt= on the command line still switches it.
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_LAZY is not set
CONFIG_PREEMPT_DYNAMIC=y

# zstd modules: faster to load.
CONFIG_MODULE_COMPRESS_ZSTD=y
# CONFIG_MODULE_COMPRESS_XZ is not set

# teo idle governor, selected with cpuidle.governor=teo.
CONFIG_CPU_IDLE_GOV_TEO=y

# No console flicker at boot.
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y

# Interrupt time is not charged to the running task.
CONFIG_IRQ_TIME_ACCOUNTING=y

# Sign in-tree modules with a key made for each build.
CONFIG_MODULE_SIG_ALL=y

# Kept from Debian: stops the build when the Rust toolchain is missing.
CONFIG_RUST=y
