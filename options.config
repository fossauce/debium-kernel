# Changes to Debian's config, each checked in the final .config.

CONFIG_HZ_1000=y
CONFIG_HZ=1000

# Default model; preempt= switches it.
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_LAZY is not set
CONFIG_PREEMPT_DYNAMIC=y

CONFIG_MODULE_COMPRESS_ZSTD=y
# CONFIG_MODULE_COMPRESS_XZ is not set

# Selected with cpuidle.governor=teo.
CONFIG_CPU_IDLE_GOV_TEO=y

CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
CONFIG_IRQ_TIME_ACCOUNTING=y

# Per-build signing key.
CONFIG_MODULE_SIG_ALL=y

# As Debian; fails the build without the Rust toolchain.
CONFIG_RUST=y
